{
  "name": "@mridang/eslint-plugin-dotenv",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "tsc",
    "test": "jest --verbose --config=jest.config.mjs",
    "test:debug": "jest --verbose --config=jest.config.mjs --detectOpenHandles",
    "test:watch": "npm run test -- --watch",
    "typecheck": "tsc --noEmit"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": true,
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "dotenv",
    "env",
    "linter"
  ],
  "author": {
    "name": "Mridang Agarwalla",
    "email": "mridang.agarwalla@gmail.com",
    "url": "https://github.com/mridang"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "description": "An ESLint plugin that lints .env files, porting the checks of dotenv-linter.",
  "private": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mridang/eslint-plugin-dotenv.git"
  },
  "homepage": "https://github.com/mridang/eslint-plugin-dotenv",
  "bugs": "https://github.com/mridang/eslint-plugin-dotenv/issues",
  "dependencies": {
    "@eslint/core": "^1.2.1",
    "@eslint/plugin-kit": "^0.7.3",
    "email-validator": "^2.0.4"
  },
  "peerDependencies": {
    "eslint": "^9.15.0 || ^10.0.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@jest/globals": "^30.0.3",
    "@mridang/eslint-defaults": "^2.5.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.0",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.12",
    "eslint": "^9.39.5",
    "jest": "^30.0.3",
    "jest-junit": "^17.0.0",
    "knip": "^6.17.1",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.1",
    "ts-jest": "^29.4.0",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
